rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir su propia biblioteca.
    // Estructura: users/{uid}/library/{docId}
    match /users/{userId}/library/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // El resto de la base de datos queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
